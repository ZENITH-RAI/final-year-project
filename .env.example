# Flask / database
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:password@localhost:5432/carresell_db
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=replace-this-password

# Public HTTPS URL used for eSewa success and failure callbacks in deployment.
# Leave blank only for a same-machine local UAT demonstration.
PUBLIC_BASE_URL=https://your-domain.example

# eSewa ePay V2
# UAT works with eSewa's public test merchant defaults even if the next two
# values are omitted. They are listed here to make the configuration explicit.
ESEWA_ENVIRONMENT=uat
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Optional endpoint overrides. Leave commented for normal UAT/production use.
# ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
# ESEWA_STATUS_URL=https://uat.esewa.com.np/api/epay/transaction/status/
